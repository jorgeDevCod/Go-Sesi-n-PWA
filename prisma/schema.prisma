generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  defaultsSeeded Boolean  @default(false)
  seedVersion    Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categories    Category[]
  subcategories Subcategory[]
  focusSessions FocusSession[]
  dailyPlans    DailyPlan[]
  preference    UserPreference?
  moods         DailyMood[]
  feedbacks     RecommendationFeedback[]
  resetToken    PasswordResetToken?
  pushSubscriptions PushSubscription[]

  @@map("users")
}

enum Complexity {
  LOW
  MEDIUM
  HIGH
}

model Category {
  id         String     @id @default(cuid())
  key        String?
  name       String
  icon       String
  color      String
  order      Int        @default(0)
  isDefault  Boolean    @default(false)
  complexity         Complexity  @default(MEDIUM)
  energyLevel        String?
  energyComplexity   Complexity?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subcategories Subcategory[]
  planItems     PlanItem[]

  @@unique([userId, key])
  @@unique([userId, name])
  @@index([userId, order])
  @@index([userId, deletedAt])
  @@map("categories")
}

model Subcategory {
  id         String   @id @default(cuid())
  name       String
  icon       String
  color      String
  order      Int      @default(0)
  complexity         Complexity  @default(MEDIUM)
  energyLevel        String?
  energyComplexity   Complexity?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  focusSessions FocusSession[]
  planItems     PlanItem[]
  feedbacks     RecommendationFeedback[]

  @@unique([userId, categoryId, name])
  @@index([userId, categoryId, order])
  @@index([userId, deletedAt])
  @@map("subcategories")
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  INTERRUPTED
}

enum SessionMode {
  CLASSIC
  POMODORO
}

model FocusSession {
  id             String        @id @default(cuid())
  status         SessionStatus @default(ACTIVE)
  mode           SessionMode   @default(CLASSIC)
  pomodoroConfig Json?
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  plannedMinutes Int
  actualMinutes  Int?
  pausedMs       Int           @default(0)
  pausedAt         DateTime?
  extendedCount    Int           @default(0)
  extendedMinutes  Int           @default(0)
  energyLevel      String?
  comment          String?

  activeUserId String? @unique

  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, startedAt])
  @@map("focus_sessions")
}

model UserPreference {
  id               String   @id @default(cuid())
  energy           String?
  preferredMinutes Int?
  dontAskAgain     Boolean  @default(false)
  data             Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model RecommendationFeedback {
  id        String   @id @default(cuid())
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([userId, subcategoryId])
  @@map("recommendation_feedbacks")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model DailyMood {
  id        String   @id @default(cuid())
  date      DateTime
  energy    String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_moods")
}

model DailyPlan {
  id        String     @id @default(cuid())
  userId    String
  date      DateTime
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     PlanItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, date])
  @@map("daily_plans")
}

model PlanItem {
  id        String  @id @default(cuid())
  planId    String
  plan      DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  categoryId String?
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  title     String
  icon      String  @default("Star")
  color     String  @default("#6366F1")
  order     Int     @default(0)
  completed Boolean @default(false)

  @@index([planId, order])
  @@map("plan_items")
}
