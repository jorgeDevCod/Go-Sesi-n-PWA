# ── Base de datos (Postgres) ────────────────────────────────────────────────
# Desarrollo (docker-compose):
# DATABASE_URL="postgresql://umbral:umbral_dev_password@localhost:5432/umbral?schema=public"
#
# Producción (Neon - plan gratuito). Usa la cadena de conexión "pooled" de Neon:
# DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require&schema=public"
DATABASE_URL="postgresql://umbral:umbral_dev_password@localhost:5432/umbral?schema=public"

# ── Auth (NextAuth v5) ──────────────────────────────────────────────────────
# Genera un secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# o: npx auth secret
AUTH_SECRET=""

# ── URL pública del sitio (para metadatos SEO / OpenGraph) ──────────────────
# En producción se setea al dominio real, p.ej. https://go-sesion.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
