# ── Base de datos (Postgres) ────────────────────────────────────────────────
# Desarrollo (docker-compose):
# DATABASE_URL="postgresql://umbral:umbral_dev_password@localhost:5432/umbral?schema=public"
#
# Producción (Neon - plan gratuito). Usa la cadena de conexión "pooled" de Neon:
# DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require&schema=public"
DATABASE_URL="postgresql://umbral:umbral_dev_password@localhost:5432/umbral?schema=public"

# ── Auth (NextAuth v5) ──────────────────────────────────────────────────────
# Genera un secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# o: npx auth secret
AUTH_SECRET=""

# ── URL pública del sitio (para metadatos SEO / OpenGraph) ──────────────────
# En producción se setea al dominio real, p.ej. https://go-sesion.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Email transaccional (Resend, opcional) ───────────────────────────────────
# Sin esta clave, "olvidé mi contraseña" responde igual pero no envía correos.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Go Sesión <hola@tudominio.com>"

# ── Push VAPID ────────────────────────────────────────────────────────────────
# Genera las tuyas con: npx web-push generate-vapid-keys
# La pública va con NEXT_PUBLIC_ (la usa el navegador para suscribirse).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:hola@tudominio.com"

# ── Zona horaria del "día" de planificación ───────────────────────────────────
# El servidor (Vercel = UTC) no debe desfasar el "hoy" del usuario.
APP_TIMEZONE="America/Lima"
